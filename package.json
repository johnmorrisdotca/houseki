{
  "name": "@johnmorrisdotca/houseki",
  "version": "0.2.1",
  "description": "Houseki 宝石: five original gem and stone puzzle engines, 450 graded challenges, bilingual lessons, deterministic saves, magnetic floors, Shizen and Arashi campaigns. TypeScript. Zero dependencies.",
  "keywords": [
    "puzzle",
    "puzzle-game",
    "match-three",
    "match-3",
    "falling-triplets",
    "colour-chains",
    "stone-collapse",
    "gem-swap",
    "magnetic-blocks",
    "gravity",
    "cascade",
    "game-engine",
    "levels",
    "immutable",
    "deterministic",
    "seeded-random",
    "accessible",
    "touch",
    "keyboard",
    "japanese",
    "typescript",
    "javascript",
    "zero-dependencies",
    "browser",
    "node",
    "itsutsu",
    "shizen",
    "arashi",
    "campaign"
  ],
  "homepage": "https://johnmorrisdotca.github.io/houseki/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnmorrisdotca/houseki.git"
  },
  "bugs": {
    "url": "https://github.com/johnmorrisdotca/houseki/issues"
  },
  "author": {
    "name": "John Morris",
    "email": "john@johnmorris.ca",
    "url": "https://johnmorris.ca"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./falling-triplets": {
      "types": "./dist/falling-triplets.d.ts",
      "import": "./dist/falling-triplets.js",
      "default": "./dist/falling-triplets.js"
    },
    "./colour-chains": {
      "types": "./dist/colour-chains.d.ts",
      "import": "./dist/colour-chains.js",
      "default": "./dist/colour-chains.js"
    },
    "./stone-collapse": {
      "types": "./dist/stone-collapse.d.ts",
      "import": "./dist/stone-collapse.js",
      "default": "./dist/stone-collapse.js"
    },
    "./gem-swap": {
      "types": "./dist/gem-swap.d.ts",
      "import": "./dist/gem-swap.js",
      "default": "./dist/gem-swap.js"
    },
    "./nature": {
      "types": "./dist/nature.d.ts",
      "import": "./dist/nature.js",
      "default": "./dist/nature.js"
    },
    "./magnetic-blocks": {
      "types": "./dist/magnetic-blocks.d.ts",
      "import": "./dist/magnetic-blocks.js",
      "default": "./dist/magnetic-blocks.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && vitest run",
    "test:package": "pnpm build && node scripts/check-package.mjs",
    "family:readme": "node scripts/family-readme.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "prepublishOnly": "pnpm check && pnpm build",
    "site": "pnpm build && node scripts/site.mjs",
    "test:demo": "pnpm site && playwright test && node --test --test-concurrency=2 e2e/review/appearance-api.test.mjs e2e/review/endings.test.mjs e2e/review/full-board-recovery.test.mjs e2e/review/nature-previews.test.mjs e2e/review/responsive.test.mjs",
    "screenshots:readme": "pnpm site && node scripts/readme-pictures.mjs",
    "test:readme": "pnpm build && node scripts/check-readme-examples.mjs",
    "test:review": "pnpm site && node --test --test-concurrency=2 e2e/review/appearance-api.test.mjs e2e/review/endings.test.mjs e2e/review/full-board-recovery.test.mjs e2e/review/nature-previews.test.mjs e2e/review/responsive.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.11.0"
}
